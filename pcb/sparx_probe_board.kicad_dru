(version 1)
# JLCPCB 4 layers (1 oz outer, JLC04161H-3313) and Aisler 4 layers ENIG at once: per rule the stricter value of the two.
# Sources: jlcpcb.com/capabilities/pcb-capabilities and community.aisler.net topic 3733, read 2026-10-01.
(rule "fab: track width"
    (constraint track_width (min 0.125mm)))
(rule "fab: clearance"
    (constraint clearance (min 0.125mm)))
(rule "fab: copper to edge"
    (constraint edge_clearance (min 0.3mm)))
(rule "fab: vias"
    (condition "A.Type == 'Via'")
    (constraint hole_size (min 0.25mm) (max 0.45mm))
    (constraint annular_width (min 0.1mm))
    (constraint via_diameter (min 0.45mm)))
(rule "fab: plated through-hole pads"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint hole_size (min 0.5mm) (max 5.6mm))
    (constraint annular_width (min 0.3mm)))
(rule "fab: non-plated holes"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
    (constraint hole_size (min 0.5mm) (max 5.6mm)))
(rule "fab: hole to hole"
    (constraint hole_to_hole (min 0.45mm)))
(rule "fab: hole to hole, via to via"
    (condition "A.Type == 'Via' && B.Type == 'Via'")
    (constraint hole_to_hole (min 0.3mm)))
(rule "fab: hole to copper"
    (constraint hole_clearance (min 0.28mm)))
(rule "fab: via hole to copper"
    (condition "A.Type == 'Via'")
    (constraint hole_clearance (min 0.25mm)))
(rule "fab: silkscreen text"
    (condition "A.Layer == '?.Silkscreen'")
    (constraint text_height (min 1mm))
    (constraint text_thickness (min 0.15mm)))
# House rules, after the fab block. Each one is at or above every fab floor.
(rule "house: 45 degree corners"
    (severity warning)
    (condition "A.Type == 'Track'")
    (constraint track_angle (min 134)))
(rule "house: copper to edge"
    (constraint edge_clearance (min 0.5mm)))
(rule "house: supply tracks"
    (condition "A.Type == 'Track' && A.NetClass == 'Power'")
    (constraint track_width (min 0.6mm)))
(rule "house: silkscreen text"
    (condition "A.Layer == '?.Silkscreen'")
    (constraint text_height (min 1.0mm))
    (constraint text_thickness (min 0.15mm)))
