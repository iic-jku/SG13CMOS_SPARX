	(text "Supply: VIN through LDO, or VDD fed directly (JP1)"
		(exclude_from_sim no)
		(at 260.35 16.51 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "63a29b33-31d8-525d-af1a-a8ce6d81cc35")
	)
	(text "JP1 1-2 (default): VDD from the LP5907 (VIN 3.3 to 5 V on the red jack).\nJP1 2-3: VDD straight from the yellow jack, 1.4 to 1.6 V, never above 1.6 V.\nOutput capacitance on the LDO: C10 + C1-C8 = 3.2 uF (LP5907: at most 10 uF).\nVDD draws 17.5 mA (4.4 mA per detector, simulated)."
		(exclude_from_sim no)
		(at 304.8 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "81383fc0-b758-5f1b-a41f-f1e332b39bc5")
	)
	(text "Mechanical: carrier screws, fiducials, bond test pad"
